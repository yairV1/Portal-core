# Copia este archivo a ".env" (ese sí gitignorado) y pon tus propios valores
# reales. docker-compose.yml lo lee automáticamente — nunca escribas
# credenciales reales directo en docker-compose.yml ni en config/database.php.

DB_NAME=portal_core
DB_USER=portal_user
DB_PASS=cambia_esto
DB_ROOT_PASS=cambia_esto_tambien

APP_PORT=8080
PMA_PORT=8081

# Login con Google (opcional) — sin esto, el botón "Continuar con Google"
# avisa que no está configurado, el resto del portal funciona igual. El
# MISMO Client ID/Secret también habilita "Mi Google Drive" en Gestión
# Documental (ver DriveUsuarioController.php) — cada usuario conecta SU
# PROPIA cuenta para traer sus archivos, sin cuenta de servicio de por medio.
# Cómo conseguirlos: https://console.cloud.google.com/apis/credentials
#   1. Crear credenciales → ID de cliente de OAuth → Aplicación web.
#   2. En "URI de redirección autorizados" agrega LAS DOS (login y Drive
#      personal son rutas distintas):
#        http://localhost:8080/auth/google/callback              (local)
#        http://localhost:8080/gestion-documental/drive/callback (local)
#        https://tu-dominio-real/auth/google/callback              (producción)
#        https://tu-dominio-real/gestion-documental/drive/callback (producción)
#   3. Copia el Client ID y el Client secret acá abajo.
#   4. Si tu institución usa Google Workspace (correos @tu-dominio, no Gmail
#      sueltos): en "Pantalla de consentimiento de OAuth" elige tipo
#      "Interno" — así nadie ve el aviso de "app no verificada" y no hace
#      falta pasar por la revisión de Google para el scope de Drive.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Cifra el refresh_token que Google entrega al conectar "Mi Google Drive"
# (ver arriba) antes de guardarlo en usuarios.google_drive_refresh_token —
# ese token es acceso de LARGA duración al Drive personal completo de quien
# lo conectó; sin cifrar, cualquiera con lectura sobre la BD (un backup, una
# fuga) se lo lleva tal cual. AES-256-GCM (ver GoogleDrive.php,
# google_drive_refresh_token_cifrar()/_descifrar()) — sin esta clave
# configurada, "Conectar mi Google Drive" no guarda nada y avisa que no está
# configurado, en vez de guardar el token sin cifrar.
#   1. Genera un secreto random: openssl rand -hex 32
#   2. Pégalo acá abajo. Es tuyo, distinto del de OnlyOffice/Google — no lo
#      compartas entre entornos ni lo cambies una vez haya gente conectada
#      (rotarlo invalida los tokens ya guardados; cada quien tendría que
#      reconectar su Drive desde Gestión Documental).
APP_ENCRYPTION_KEY=

# "Traer de Drive" en Administrativa y Financiera (opcional) — cuenta de
# servicio de Google Cloud, NO el mismo tipo de credencial que la de arriba.
# Cómo conseguirla (mismo proyecto de Google Cloud que ya creaste):
#   1. Habilita "Google Drive API" en el proyecto (APIs y servicios → Biblioteca).
#   2. Credenciales → Crear credenciales → Cuenta de servicio → dale un
#      nombre (ej. "portal-core-drive") → Listo (no hace falta darle rol).
#   3. Entra a esa cuenta de servicio → pestaña "Claves" → Agregar clave →
#      Crear clave nueva → JSON → se descarga un archivo.
#   4. Copia ese archivo a storage/google/drive-service-account.json (esa
#      carpeta ya está lista y gitignorada).
#   5. En Drive, comparte cada carpeta/archivo que quieras poder importar
#      con el "correo" de esa cuenta de servicio (termina en
#      .iam.gserviceaccount.com, está dentro del mismo .json como
#      "client_email") — como si fuera una persona más, con acceso de Lector.
GOOGLE_DRIVE_SERVICE_ACCOUNT_FILE=/var/www/html/storage/google/drive-service-account.json
