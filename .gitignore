/config/local.php
/config/database.local.php

# Basura que genera cada sistema operativo al navegar carpetas — no es del
# proyecto, y sin esto un dev en Windows o Mac puede subirla sin querer.
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
.DS_Store
.AppleDouble
.Spotlight-V100

# Documentos subidos (ver DocumentoController.php) — contenido de usuarios,
# no código; se queda fuera de public/ a propósito (no debe ser accesible
# por URL directa, ver el comentario en DocumentoController.php).
/storage/documentos/*
!/storage/documentos/.gitkeep

# Hojas de vida y fotos de postulantes (ver TrabajoController.php) — datos
# personales de candidatos, no código.
/storage/postulaciones/*
!/storage/postulaciones/.gitkeep

# Documentos del formulario de contratación (ver ContratacionController.php)
# — cédula, RUT, certificados, etc. de candidatos, no código.
/storage/contrataciones/*
!/storage/contrataciones/.gitkeep

# Explorador de documentos tipo "drive" de un módulo de dirección (ver
# CarpetaController.php) — arranca en Administrativa y Financiera.
/storage/direccion_carpetas/*
!/storage/direccion_carpetas/.gitkeep


